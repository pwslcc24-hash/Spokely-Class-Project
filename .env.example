# Copy to ".env" and adjust values. Never commit the real .env file.

# Required for production: set a long random value (replace the example below).
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-replace-with-secrets-token-hex-before-production

# Database: SQLAlchemy connection URI.
# Default SQLite in project directory (if unset, same path is used as fallback):
#   sqlite:///path/to/project.db
# For SQLite, prefer an absolute path in production, e.g.:
#   sqlite:////var/lib/spokely/project.db
DATABASE_URL=

# Development server (python web_app.py) only. Use 0 for production; set 1 for local dev auto-reload.
# Gunicorn ignores this.
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Optional: gunicorn example (use 1 worker with SQLite to avoid file locking):
#   gunicorn -w 1 wsgi:app --bind 0.0.0.0:8000
